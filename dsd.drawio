d\n    }\n    \n    notifications {\n        uuid id PK\n        text title\n        text message\n        text type\n        text priority\n        boolean is_read\n        text recipient\n        timestamp created_at\n    }\n    \n    email_queue {\n        uuid id PK\n        uuid notification_id FK\n        text subject\n        text recipient_email\n        boolean is_sent\n        timestamp scheduled_at\n        timestamp sent_at\n        timestamp created_at\n    }\n    \n    audit_logs {\n        uuid id PK\n        text table_name\n        uuid record_id\n        text action\n        jsonb old_data\n        jsonb new_data\n        uuid changed_by FK\n        timestamp changed_at\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="5qHsp0sBLuGbDiOzllUy-313">
